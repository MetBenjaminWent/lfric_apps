#!/bin/bash

set -e

PREVIOUS_WORKING_DIR="${CYLC_TASK_WORK_DIR}/../${PREVIOUS_JOB}"
OUTPUT_TARGET="${EXPORT_TARGET:-${DATADIR}}"

if [[ -z "${OUTPUT_TARGET}" ]]; then
	OUTPUT_TARGET="${HOME}"
fi

# Extend the target with the name of the workflow, then a sub folder of the job
OUTPUT_TARGET="${OUTPUT_TARGET}/${CYLC_WORKFLOW_ID}/${PREVIOUS_JOB}"

mapfile -t VERNIER_FILES < <(ls -d "${PREVIOUS_WORKING_DIR}"/vernier-output* 2>/dev/null || true)

if [[ ${#VERNIER_FILES[@]} -eq 0 ]]; then
	echo "No vernier-output files found in ${PREVIOUS_WORKING_DIR}" >&2
	exit 1
fi

printf 'Vernier files to export:\n'
printf '  %s\n' "${VERNIER_FILES[@]}"
rsync -av --mkpath "${VERNIER_FILES[@]}" "${OUTPUT_TARGET%/}/"
